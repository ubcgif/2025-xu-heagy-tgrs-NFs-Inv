@article{sun_coil_2021,
	title = {{CoIL}: {Coordinate}-{Based} {Internal} {Learning} for {Tomographic} {Imaging}},
	volume = {7},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {2333-9403, 2334-0118, 2573-0436},
	shorttitle = {{CoIL}},
	url = {https://ieeexplore.ieee.org/document/9606601/},
	doi = {10.1109/TCI.2021.3125564},
	abstract = {We propose Coordinate-based Internal Learning (CoIL) as a new deep-learning (DL) methodology for continuous representation of measurements. Unlike traditional DL methods that learn a mapping from the measurements to the desired image, CoIL trains a multilayer perceptron (MLP) to encode the complete measurement ﬁeld by mapping the coordinates of the measurements to their responses. CoIL is a self-supervised method that requires no training examples besides the measurements of the test object itself. Once the MLP is trained, CoIL generates new measurements that can be used within most image reconstruction methods. We validate CoIL on sparse-view computed tomography using several widely-used reconstruction methods, including purely model-based methods and those based on DL. Our results demonstrate the ability of CoIL to consistently improve the performance of all the considered methods by providing high-ﬁdelity measurement ﬁelds.},
	language = {en},
	urldate = {2024-06-03},
	journal = {IEEE Trans. Comput. Imaging},
	author = {Sun, Yu and Liu, Jiaming and Xie, Mingyang and Wohlberg, Brendt and Kamilov, Ulugbek},
	year = {2021},
	pages = {1400--1412},
	file = {Sun et al. - 2021 - CoIL Coordinate-Based Internal Learning for Tomog.pdf:/Users/anranxu/Zotero/storage/RQP72V3Q/Sun et al. - 2021 - CoIL Coordinate-Based Internal Learning for Tomog.pdf:application/pdf},
}


